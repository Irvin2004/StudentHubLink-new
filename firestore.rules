rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == "admin";
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == "student";
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
        );
      allow delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && unchanged("averageRating")
          && unchanged("reviewCount")
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.resourceId == resource.data.resourceId;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.resourceId == resource.data.resourceId;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /libraries/{libraryId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    function conversationFor(conversationId) {
      return get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
        );
    }

    function canAccessConversation(conversation) {
      return signedIn()
        && (
          (
            conversation.get("type", "direct") == "direct"
            && request.auth.uid in conversation.participantIds
          )
          ||
          (
            conversation.get("type", "direct") == "group"
            && isGroupMember(conversation.groupId)
          )
        );
    }

    match /conversations/{conversationId} {
      allow read: if canAccessConversation(resource.data);
      allow create: if signedIn()
        && (
          (
            request.resource.data.type == "direct"
            && request.auth.uid in request.resource.data.participantIds
            && request.resource.data.participantIds.size() == 2
          )
          ||
          (
            request.resource.data.type == "group"
            && conversationId == "group_" + request.resource.data.groupId
            && isGroupMember(request.resource.data.groupId)
            && request.resource.data.title == get(
              /databases/$(database)/documents/groups/$(request.resource.data.groupId)
            ).data.name
          )
        );
      allow update: if canAccessConversation(resource.data)
        && request.resource.data.get("type", "direct")
          == resource.data.get("type", "direct")
        && request.resource.data.get("participantIds", [])
          == resource.data.get("participantIds", [])
        && request.resource.data.get("conversationKey", "")
          == resource.data.get("conversationKey", "")
        && request.resource.data.get("groupId", "")
          == resource.data.get("groupId", "")
        && request.resource.data.get("title", "")
          == resource.data.get("title", "");
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if canAccessConversation(
        conversationFor(resource.data.conversationId)
      );
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.edited == false
        && request.resource.data.editedAt == null
        && request.resource.data.deleted == false
        && request.resource.data.deletedFor == []
        && request.resource.data.deletedAt == null
        && request.resource.data.deliveredAt == null
        && request.resource.data.readAt == null
        && canAccessConversation(
          conversationFor(request.resource.data.conversationId)
        )
        && (
          (
            conversationFor(request.resource.data.conversationId)
              .get("type", "direct") == "direct"
            && request.resource.data.receiverId != request.auth.uid
            && request.resource.data.receiverId in conversationFor(
              request.resource.data.conversationId
            ).participantIds
            && request.resource.data.get("groupId", null) == null
            && request.resource.data.readBy == []
          )
          ||
          (
            conversationFor(request.resource.data.conversationId)
              .get("type", "direct") == "group"
            && request.resource.data.receiverId == null
            && request.resource.data.groupId == conversationFor(
              request.resource.data.conversationId
            ).groupId
            && request.resource.data.readBy == [request.auth.uid]
          )
        );
      allow update: if signedIn()
        && (
          (
            request.auth.uid == resource.data.receiverId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["deliveredAt", "readAt"])
          )
          ||
          (
            canAccessConversation(conversationFor(resource.data.conversationId))
            && resource.data.get("groupId", null) != null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["readBy"])
            && request.resource.data.readBy is list
            && request.resource.data.readBy.toSet()
              == resource.data.get("readBy", []).toSet()
                .union([request.auth.uid].toSet())
            && request.resource.data.readBy.size()
              == request.resource.data.readBy.toSet().size()
          )
          ||
          (
            canAccessConversation(conversationFor(resource.data.conversationId))
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["reactions"])
          )
          ||
          (
            request.auth.uid == resource.data.senderId
            && resource.data.type == "text"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["text", "edited", "editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.edited == true
            && request.resource.data.editedAt == request.time
          )
          ||
          (
            request.auth.uid == resource.data.senderId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "text", "deleted", "deletedAt", "fileUrl",
                "fileName", "fileSize", "mimeType"
              ])
            && request.resource.data.text == "This message was deleted."
            && request.resource.data.deleted == true
            && request.resource.data.deletedAt == request.time
            && request.resource.data.fileUrl == null
            && request.resource.data.fileName == null
            && request.resource.data.fileSize == null
            && request.resource.data.mimeType == null
          )
          ||
          (
            canAccessConversation(conversationFor(resource.data.conversationId))
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["deletedFor"])
            && request.resource.data.deletedFor is list
            && request.resource.data.deletedFor.toSet()
              == resource.data.get("deletedFor", []).toSet()
                .union([request.auth.uid].toSet())
            && request.resource.data.deletedFor.size()
              == request.resource.data.deletedFor.toSet().size()
          )
        );
      allow delete: if false;
    }
    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(["online", "lastSeen"])
        && request.resource.data.online is bool;
      allow delete: if false;
    }

    match /typingStatus/{typingId} {
      allow read: if canAccessConversation(
        conversationFor(resource.data.conversationId)
      );
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && typingId == request.resource.data.conversationId + "_" + request.auth.uid
        && canAccessConversation(
          conversationFor(request.resource.data.conversationId)
        )
        && request.resource.data.keys().hasOnly([
          "conversationId",
          "userId",
          "displayName",
          "typing",
          "updatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.typing is bool;
      allow delete: if false;
    }
    match /groups/{groupId} {
      function groupFieldsAreValid() {
        return request.resource.data.keys().hasOnly([
            "name",
            "description",
            "moduleCode",
            "moduleName",
            "tags",
            "ownerId",
            "visibility",
            "photoURL",
            "memberCount",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.moduleCode is string
          && request.resource.data.moduleCode.size() <= 30
          && request.resource.data.moduleName is string
          && request.resource.data.moduleName.size() > 0
          && request.resource.data.moduleName.size() <= 120
          && (
            !("tags" in request.resource.data)
            || (
              request.resource.data.tags is list
              && request.resource.data.tags.size() <= 5
            )
          )
          && request.resource.data.photoURL is string
          && request.resource.data.visibility in ["public", "private"]
          && request.resource.data.memberCount is int
          && request.resource.data.memberCount >= 1;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && groupFieldsAreValid()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && groupFieldsAreValid()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          resource.data.ownerId == request.auth.uid
          || (
            resource.data.visibility == "public"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["memberCount", "updatedAt"])
            && request.resource.data.memberCount
              == resource.data.memberCount + 1
            && request.resource.data.updatedAt == request.time
            && !exists(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
            && existsAfter(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
          )
          || (
            resource.data.ownerId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["memberCount", "updatedAt"])
            && request.resource.data.memberCount
              == resource.data.memberCount - 1
            && request.resource.data.updatedAt == request.time
            && exists(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
            && !existsAfter(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
          )
        );
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        function groupAfterWrite() {
          return getAfter(
            /databases/$(database)/documents/groups/$(groupId)
          );
        }

        function memberFieldsAreValid() {
          return request.resource.data.keys().hasOnly([
              "userId",
              "displayName",
              "photoURL",
              "role",
              "joinedAt"
            ])
            && request.resource.data.userId == userId
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 120
            && request.resource.data.photoURL is string
            && request.resource.data.role in [
              "owner",
              "admin",
              "moderator",
              "member"
            ];
        }

        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == userId
          && memberFieldsAreValid()
          && request.resource.data.joinedAt == request.time
          && (
            (
              groupAfterWrite().data.ownerId == request.auth.uid
              && request.resource.data.role == "owner"
            )
            ||
            (
              groupAfterWrite().data.ownerId != request.auth.uid
              && groupAfterWrite().data.visibility == "public"
              && groupAfterWrite().data.memberCount
                == get(
                  /databases/$(database)/documents/groups/$(groupId)
                ).data.memberCount + 1
              && request.resource.data.role == "member"
            )
          );
        allow update: if signedIn()
          && memberFieldsAreValid()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.joinedAt == resource.data.joinedAt
          && (
            get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.ownerId == request.auth.uid
            ||
            (
              request.auth.uid == userId
              && request.resource.data.role == resource.data.role
            )
          );
        allow delete: if signedIn()
          && resource.data.role != "owner"
          && groupAfterWrite().data.memberCount
            == get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.memberCount - 1
          && (
            request.auth.uid == userId
            || get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.ownerId == request.auth.uid
          );
      }

      match /resources/{resourceId} {
        function isGroupResourceMember() {
          return signedIn()
            && exists(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            );
        }

        function isResourceUploader() {
          return signedIn()
            && resource.data.uploaderId == request.auth.uid;
        }

        function isGroupResourceOwner() {
          return signedIn()
            && get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.ownerId == request.auth.uid;
        }

        allow read: if isGroupResourceMember();

        allow create: if isGroupResourceMember()
          && request.resource.data.uploaderId == request.auth.uid
          && request.resource.data.downloadCount == 0
          && request.resource.data.verificationCount == 0;

        allow update: if isResourceUploader()
          || isGroupResourceOwner();

        allow delete: if isResourceUploader()
          || isGroupResourceOwner();
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFriend(userId) {
      return signedIn()
        && (
          exists(
            /databases/$(database)/documents/friends/$(request.auth.uid + "_" + userId)
          )
          || exists(
            /databases/$(database)/documents/friends/$(userId + "_" + request.auth.uid)
          )
        );
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == "admin";
    }

    function isGroupManager(groupId) {
      return isGroupMember(groupId)
        && get(
          /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
        ).data.role in ["owner", "admin"];
    }

    function isCommunityMember(communityId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
        );
    }

    function isCommunityManager(communityId) {
      return isCommunityMember(communityId)
        && get(
          /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
        ).data.role in ["owner", "admin"];
    }

    function isCommunityManagerAfter(communityId) {
      return signedIn()
        && existsAfter(
          /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
        ).data.role in ["owner", "admin"];
    }

    function isCommunityModerator(communityId) {
      return isCommunityMember(communityId)
        && get(
          /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
        ).data.role in ["owner", "admin", "moderator"];
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    function notificationFieldsAreValid(userId) {
      return request.resource.data.keys().hasOnly([
          "recipientId", "senderId", "groupId", "conversationId",
          "referenceId", "title", "message", "type", "read",
          "createdAt", "updatedAt", "senderName", "communityId",
          "channelId", "route"
        ])
        && request.resource.data.keys().hasAll([
          "recipientId", "senderId",
          "referenceId", "title", "message", "type", "read",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.recipientId == userId
        && request.resource.data.recipientId is string
        && request.resource.data.senderId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.type in [
          "friend_request", "friend_accepted", "group_invite",
          "new_assignment", "assignment_due", "new_resource",
          "new_message", "mention", "channel_mention", "new_file",
          "community_activity", "system"
        ]
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function assignmentNotificationIsValid(userId) {
      let assignmentPath = /databases/$(database)/documents/groups/$(request.resource.data.groupId)/assignments/$(request.resource.data.referenceId);
      let memberPath = /databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(userId);
      return request.resource.data.type in ["new_assignment", "assignment_due"]
        && request.resource.data.senderId == request.auth.uid
        && userId != request.auth.uid
        && exists(assignmentPath)
        && get(assignmentPath).data.createdBy == request.auth.uid
        && exists(memberPath);
    }

    function messageNotificationIsValid(userId) {
      let messagePath = /databases/$(database)/documents/messages/$(request.resource.data.referenceId);
      let conversationPath = /databases/$(database)/documents/conversations/$(request.resource.data.conversationId);
      return request.resource.data.type in ["new_message", "mention"]
        && request.resource.data.senderId == request.auth.uid
        && userId != request.auth.uid
        && exists(messagePath)
        && exists(conversationPath)
        && get(messagePath).data.senderId == request.auth.uid
        && get(messagePath).data.conversationId == request.resource.data.conversationId
        && (
          (
            get(conversationPath).data.get("type", "direct") == "direct"
            && userId in get(conversationPath).data.participantIds
          )
          || (
            get(conversationPath).data.get("type", "direct") == "group"
            && request.resource.data.groupId == get(conversationPath).data.groupId
            && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(userId))
          )
        );
    }

    function communityMessageNotificationIsValid(userId) {
      let messagePath = /databases/$(database)/documents/communities/$(request.resource.data.communityId)/channels/$(request.resource.data.channelId)/messages/$(request.resource.data.referenceId);
      return request.resource.data.type in [
          "new_message", "mention", "channel_mention"
        ]
        && request.resource.data.senderId == request.auth.uid
        && userId != request.auth.uid
        && exists(messagePath)
        && get(messagePath).data.senderId == request.auth.uid
        && isCommunityMember(request.resource.data.communityId)
        && exists(
          /databases/$(database)/documents/communities/$(request.resource.data.communityId)/members/$(userId)
        );
    }

    function communityFileNotificationIsValid(userId) {
      let filePath = /databases/$(database)/documents/communities/$(request.resource.data.communityId)/channels/$(request.resource.data.channelId)/files/$(request.resource.data.referenceId);
      return request.resource.data.type == "new_file"
        && request.resource.data.senderId == request.auth.uid
        && userId != request.auth.uid
        && exists(filePath)
        && get(filePath).data.uploadedBy == request.auth.uid
        && isCommunityMember(request.resource.data.communityId)
        && exists(
          /databases/$(database)/documents/communities/$(request.resource.data.communityId)/members/$(userId)
        );
    }

    function friendNotificationIsValid(userId) {
      let friendRequestPath = /databases/$(database)/documents/friendRequests/$(request.resource.data.referenceId);
      return exists(friendRequestPath)
        && (
          (
            request.resource.data.type == "friend_request"
            && get(friendRequestPath).data.status == "pending"
            && get(friendRequestPath).data.senderId == request.auth.uid
            && get(friendRequestPath).data.receiverId == userId
          )
          || (
            request.resource.data.type == "friend_accepted"
            && get(friendRequestPath).data.status == "accepted"
            && get(friendRequestPath).data.receiverId == request.auth.uid
            && get(friendRequestPath).data.senderId == userId
          )
        );
    }

    function resourceNotificationIsValid(userId) {
      let resourcePath = /databases/$(database)/documents/groups/$(request.resource.data.groupId)/resources/$(request.resource.data.referenceId);
      return request.resource.data.type == "new_resource"
        && request.resource.data.senderId == request.auth.uid
        && userId != request.auth.uid
        && exists(resourcePath)
        && get(resourcePath).data.uploaderId == request.auth.uid
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(userId));
    }

    function notificationSourceIsValid(userId) {
      return isAdmin()
        || (
          request.resource.data.type in ["new_assignment", "assignment_due"]
          && assignmentNotificationIsValid(userId)
        )
        || (
          request.resource.data.type in ["new_message", "mention"]
          && messageNotificationIsValid(userId)
        )
        || (
          request.resource.data.type in [
            "new_message", "mention", "channel_mention"
          ]
          && communityMessageNotificationIsValid(userId)
        )
        || (
          request.resource.data.type == "new_file"
          && communityFileNotificationIsValid(userId)
        )
        || (
          request.resource.data.type in ["friend_request", "friend_accepted"]
          && friendNotificationIsValid(userId)
        )
        || (
          request.resource.data.type == "new_resource"
          && resourceNotificationIsValid(userId)
        );
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (
          isOwner(userId)
          || isAdmin()
          || isFriend(userId)
          || resource.data.get("profileVisibility", "public") == "public"
        );
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == "student";
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/studyTasks/{taskId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "title",
          "subject",
          "notes",
          "dueDate",
          "estimatedMinutes",
          "priority",
          "completed",
          "createdAt",
          "updatedAt",
          "resourceId",
          "flashcardDeckId",
          "quizId",
          "taskType"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.dueDate is string
        && request.resource.data.estimatedMinutes is int
        && request.resource.data.estimatedMinutes > 0
        && request.resource.data.priority in ["Low", "Medium", "High"]
        && request.resource.data.completed == false
        && (
          !("resourceId" in request.resource.data)
          || (
            request.resource.data.resourceId is string
            && request.resource.data.resourceId.size() > 0
          )
        )
        && (
          !("flashcardDeckId" in request.resource.data)
          || (
            request.resource.data.flashcardDeckId is string
            && request.resource.data.flashcardDeckId.size() > 0
          )
        )
        && (
          !("quizId" in request.resource.data)
          || (
            request.resource.data.quizId is string
            && request.resource.data.quizId.size() > 0
          )
        )
        && (
          !("taskType" in request.resource.data)
          || request.resource.data.taskType in ["study", "flashcards", "quiz"]
        )
        && (
          request.resource.data.get("taskType", "study") != "flashcards"
          || (
            "flashcardDeckId" in request.resource.data
            && request.resource.data.flashcardDeckId.size() > 0
          )
        )
        && (
          request.resource.data.get("taskType", "study") != "quiz"
          || (
            "quizId" in request.resource.data
            && request.resource.data.quizId.size() > 0
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "title",
            "subject",
            "notes",
            "dueDate",
            "estimatedMinutes",
            "priority",
            "completed",
            "updatedAt",
            "flashcardDeckId",
            "quizId",
            "taskType"
          ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && (
          !("notes" in request.resource.data)
          || (
            request.resource.data.notes is string
            && request.resource.data.notes.size() <= 500
          )
        )
        && request.resource.data.dueDate is string
        && request.resource.data.estimatedMinutes is int
        && request.resource.data.estimatedMinutes > 0
        && request.resource.data.priority in ["Low", "Medium", "High"]
        && request.resource.data.completed is bool
        && (
          !("flashcardDeckId" in request.resource.data)
          || (
            request.resource.data.flashcardDeckId is string
            && request.resource.data.flashcardDeckId.size() > 0
          )
        )
        && (
          !("quizId" in request.resource.data)
          || (
            request.resource.data.quizId is string
            && request.resource.data.quizId.size() > 0
          )
        )
        && (
          !("taskType" in request.resource.data)
          || request.resource.data.taskType in ["study", "flashcards", "quiz"]
        )
        && (
          request.resource.data.get("taskType", "study") != "flashcards"
          || (
            "flashcardDeckId" in request.resource.data
            && request.resource.data.flashcardDeckId.size() > 0
          )
        )
        && (
          request.resource.data.get("taskType", "study") != "quiz"
          || (
            "quizId" in request.resource.data
            && request.resource.data.quizId.size() > 0
          )
        )
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/resourceActivity/{resourceId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "userId",
          "resourceId",
          "lastOpened",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.resourceId == resourceId
        && request.resource.data.lastOpened is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/studySessions/{sessionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "title",
          "subject",
          "sourceType",
          "actualMinutes",
          "durationSeconds",
          "startedAt",
          "completedAt",
          "createdAt",
          "taskId",
          "resourceId",
          "quizId"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.sourceType in ["task", "resource", "quiz"]
        && request.resource.data.actualMinutes is int
        && request.resource.data.actualMinutes >= 0
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.startedAt is timestamp
        && request.resource.data.completedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && (
          !("taskId" in request.resource.data)
          || request.resource.data.taskId is string
        )
        && (
          !("resourceId" in request.resource.data)
          || request.resource.data.resourceId is string
        )
        && (
          !("quizId" in request.resource.data)
          || request.resource.data.quizId is string
        );
      allow update, delete: if false;
    }

    match /users/{userId}/flashcardDecks/{deckId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "title",
          "subject",
          "createdAt",
          "updatedAt",
          "resourceId",
          "lastStudiedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 80
        && (
          !("resourceId" in request.resource.data)
          || (
            request.resource.data.resourceId is string
            && request.resource.data.resourceId.size() > 0
          )
        )
        && (
          !("lastStudiedAt" in request.resource.data)
          || request.resource.data.lastStudiedAt is timestamp
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      match /cards/{cardId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "front",
            "back",
            "createdAt",
            "updatedAt",
            "lastReviewedAt",
            "nextReviewAt",
            "reviewCount",
            "easeRating"
          ])
          && request.resource.data.front is string
          && request.resource.data.front.size() > 0
          && request.resource.data.front.size() <= 1000
          && request.resource.data.back is string
          && request.resource.data.back.size() > 0
          && request.resource.data.back.size() <= 2000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            !("lastReviewedAt" in request.resource.data)
            || request.resource.data.lastReviewedAt == null
            || request.resource.data.lastReviewedAt is timestamp
          )
          && (
            !("nextReviewAt" in request.resource.data)
            || request.resource.data.nextReviewAt is timestamp
          )
          && (
            !("reviewCount" in request.resource.data)
            || (
              request.resource.data.reviewCount is int
              && request.resource.data.reviewCount >= 0
            )
          )
          && (
            !("easeRating" in request.resource.data)
            || request.resource.data.easeRating == null
            || request.resource.data.easeRating in [
              "again",
              "hard",
              "good",
              "easy"
            ]
          );
      }
    }

    match /users/{userId}/quizzes/{quizId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "title",
          "subject",
          "questionCount",
          "flashcardDeckId",
          "resourceId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 80
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount >= 0
        && (
          !("flashcardDeckId" in request.resource.data)
          || (
            request.resource.data.flashcardDeckId is string
            && request.resource.data.flashcardDeckId.size() > 0
          )
        )
        && (
          !("resourceId" in request.resource.data)
          || (
            request.resource.data.resourceId is string
            && request.resource.data.resourceId.size() > 0
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      match /questions/{questionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "prompt",
            "options",
            "correctOptionIndex",
            "position",
            "sourceFlashcardId",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() > 0
          && request.resource.data.prompt.size() <= 1000
          && request.resource.data.options is list
          && request.resource.data.options.size() == 4
          && request.resource.data.options[0] is string
          && request.resource.data.options[0].size() > 0
          && request.resource.data.options[1] is string
          && request.resource.data.options[1].size() > 0
          && request.resource.data.options[2] is string
          && request.resource.data.options[2].size() > 0
          && request.resource.data.options[3] is string
          && request.resource.data.options[3].size() > 0
          && request.resource.data.correctOptionIndex is int
          && request.resource.data.correctOptionIndex >= 0
          && request.resource.data.correctOptionIndex < 4
          && request.resource.data.position is int
          && request.resource.data.position >= 0
          && (
            !("sourceFlashcardId" in request.resource.data)
            || (
              request.resource.data.sourceFlashcardId is string
              && request.resource.data.sourceFlashcardId.size() > 0
            )
          )
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      match /attempts/{attemptId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "quizId",
            "answers",
            "score",
            "totalQuestions",
            "percentage",
            "durationSeconds",
            "taskId",
            "completedAt"
          ])
          && request.resource.data.quizId == quizId
          && request.resource.data.answers is list
          && request.resource.data.score is int
          && request.resource.data.totalQuestions is int
          && request.resource.data.totalQuestions > 0
          && request.resource.data.answers.size()
            == request.resource.data.totalQuestions
          && request.resource.data.score >= 0
          && request.resource.data.score
            <= request.resource.data.totalQuestions
          && request.resource.data.percentage is int
          && request.resource.data.percentage >= 0
          && request.resource.data.percentage <= 100
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds >= 0
          && (
            !("taskId" in request.resource.data)
            || request.resource.data.taskId is string
          )
          && request.resource.data.completedAt is timestamp;
        allow update: if false;
      }
    }

    function hasCommunityTrust(communityId, minimumRank) {
      return isCommunityMember(communityId)
        && exists(
          /databases/$(database)/documents/communities/$(communityId)/reputation/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/communities/$(communityId)/reputation/$(request.auth.uid)
        ).data.trustRank >= minimumRank;
    }

    function canCurateCommunityKnowledge(communityId) {
      return isCommunityModerator(communityId)
        || hasCommunityTrust(communityId, 1);
    }

    match /users/{userId}/thutoConversations/{resourceKey} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "userId",
          "resourceId",
          "sourceTitle",
          "activeThreadId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.sourceTitle is string
        && request.resource.data.sourceTitle.size() > 0
        && request.resource.data.sourceTitle.size() <= 200
        && request.resource.data.activeThreadId is string
        && request.resource.data.activeThreadId.size() > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "role",
            "content",
            "threadId",
            "createdAt"
          ])
          && request.resource.data.role in ["user", "assistant"]
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 20000
          && request.resource.data.threadId is string
          && request.resource.data.threadId.size() > 0
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/learningMemory/{topicKey} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "userId",
          "topicKey",
          "topic",
          "studiedCount",
          "studyMinutes",
          "quizAttempts",
          "quizScoreTotal",
          "latestQuizPercentage",
          "flashcardReviews",
          "correctSignals",
          "struggleSignals",
          "updatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.topicKey == topicKey
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.topic.size() <= 160
        && request.resource.data.studiedCount is int
        && request.resource.data.studiedCount >= 0
        && request.resource.data.studyMinutes is int
        && request.resource.data.studyMinutes >= 0
        && request.resource.data.quizAttempts is int
        && request.resource.data.quizAttempts >= 0
        && request.resource.data.quizScoreTotal is int
        && request.resource.data.quizScoreTotal >= 0
        && request.resource.data.flashcardReviews is int
        && request.resource.data.flashcardReviews >= 0
        && request.resource.data.correctSignals is int
        && request.resource.data.correctSignals >= 0
        && request.resource.data.struggleSignals is int
        && request.resource.data.struggleSignals >= 0
        && (
          !("latestQuizPercentage" in request.resource.data)
          || (
            request.resource.data.latestQuizPercentage is int
            && request.resource.data.latestQuizPercentage >= 0
            && request.resource.data.latestQuizPercentage <= 100
          )
        )
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;

      match /concepts/{conceptKey} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "userId",
            "topicKey",
            "label",
            "correctSignals",
            "struggleSignals",
            "updatedAt"
          ])
          && request.resource.data.userId == userId
          && request.resource.data.topicKey == topicKey
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 300
          && request.resource.data.correctSignals is int
          && request.resource.data.correctSignals >= 0
          && request.resource.data.struggleSignals is int
          && request.resource.data.struggleSignals >= 0
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /activities/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "userId",
            "topicKey",
            "type",
            "detail",
            "sourceId",
            "occurredAt"
          ])
          && request.resource.data.userId == userId
          && request.resource.data.topicKey == topicKey
          && request.resource.data.type in [
            "quiz",
            "flashcard",
            "study-session",
            "thuto"
          ]
          && request.resource.data.detail is string
          && request.resource.data.detail.size() <= 500
          && request.resource.data.sourceId is string
          && request.resource.data.sourceId.size() <= 200
          && request.resource.data.occurredAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/studySettings/{settingId} {
      allow read: if isOwner(userId) && settingId == "planner";
      allow create, update: if isOwner(userId)
        && settingId == "planner"
        && request.resource.data.keys().hasOnly([
          "weeklyGoalMinutes",
          "updatedAt"
        ])
        && request.resource.data.weeklyGoalMinutes is int
        && request.resource.data.weeklyGoalMinutes >= 60
        && request.resource.data.weeklyGoalMinutes <= 2400
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Collection-group membership lookups must be restricted to the signed-in
    // user's own membership documents. Group-specific reads remain governed by
    // the narrower rule under /groups/{groupId}/members/{userId} below.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "senderId", "receiverId", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.receiverId is string
        && requestId in [
          request.resource.data.senderId + "_" + request.resource.data.receiverId,
          request.resource.data.receiverId + "_" + request.resource.data.senderId
        ]
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "senderId", "receiverId", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "declined"]
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn()
        && request.auth.uid in [resource.data.senderId, resource.data.receiverId];
    }

    match /friends/{friendId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "participantIds", "requestId", "createdAt"
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && friendId in [
          request.resource.data.participantIds[0] + "_" + request.resource.data.participantIds[1],
          request.resource.data.participantIds[1] + "_" + request.resource.data.participantIds[0]
        ]
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.requestId is string
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
        ).data.receiverId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
        ).data.status == "accepted"
        && request.resource.data.participantIds.toSet()
          == [
            getAfter(
              /databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)
            ).data.senderId,
            request.auth.uid
          ].toSet();
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    match /resources/{resourceId} {
      allow read: if resource.data.approved == true
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.downloadCount == 0
        && request.resource.data.purchaseCount == 0;
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.status == resource.data.status
          && unchanged("averageRating")
          && unchanged("reviewCount")
          && unchanged("downloadCount")
          && unchanged("purchaseCount")
        )
        || (
          signedIn()
          && resource.data.approved == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["downloadCount", "updatedAt"])
          && request.resource.data.downloadCount
            == resource.data.downloadCount + 1
          && request.resource.data.updatedAt == request.time
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && reviewId == request.resource.data.resourceId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          "resourceId", "userId", "userName", "rating", "review",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() > 0
        && request.resource.data.review.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.resourceId == resource.data.resourceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["rating", "review", "updatedAt"])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() > 0
        && request.resource.data.review.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "resourceId", "userId", "userName", "message",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.resourceId == resource.data.resourceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["message", "updatedAt"])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "userId", "resourceId", "resourceKey", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.resourceKey
          == request.resource.data.resourceId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /libraries/{libraryId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    function conversationFor(conversationId) {
      return get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
        );
    }

    function canAccessConversation(conversation) {
      return signedIn()
        && (
          (
            conversation.get("type", "direct") == "direct"
            && request.auth.uid in conversation.participantIds
          )
          ||
          (
            conversation.get("type", "direct") == "group"
            && isGroupMember(conversation.groupId)
          )
        );
    }

    match /conversations/{conversationId} {
      allow read: if canAccessConversation(resource.data);
      allow create: if signedIn()
        && (
          (
            request.resource.data.type == "direct"
            && request.auth.uid in request.resource.data.participantIds
            && request.resource.data.participantIds.size() == 2
          )
          ||
          (
            request.resource.data.type == "group"
            && conversationId == "group_" + request.resource.data.groupId
            && isGroupMember(request.resource.data.groupId)
            && request.resource.data.title == get(
              /databases/$(database)/documents/groups/$(request.resource.data.groupId)
            ).data.name
          )
        );
      allow update: if canAccessConversation(resource.data)
        && request.resource.data.get("type", "direct")
          == resource.data.get("type", "direct")
        && request.resource.data.get("participantIds", [])
          == resource.data.get("participantIds", [])
        && request.resource.data.get("conversationKey", "")
          == resource.data.get("conversationKey", "")
        && request.resource.data.get("groupId", "")
          == resource.data.get("groupId", "")
        && request.resource.data.get("title", "")
          == resource.data.get("title", "");
      allow delete: if false;
    }

    match /conversations/{conversationId}/messages/{messageId}/reactions/{userId} {
      function sourceMessage() {
        return get(
          /databases/$(database)/documents/messages/$(messageId)
        );
      }

      function canAccessReactionMessage() {
        return exists(
            /databases/$(database)/documents/messages/$(messageId)
          )
          && sourceMessage().data.conversationId == conversationId
          && canAccessConversation(conversationFor(conversationId));
      }

      function reactionFieldsAreValid() {
        return request.resource.data.keys().hasOnly([
            "reaction", "createdAt", "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "reaction", "createdAt", "updatedAt"
          ])
          && request.resource.data.reaction in [
            "👍", "❤️", "😂", "😮", "🎉"
          ]
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if canAccessReactionMessage();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && canAccessReactionMessage()
        && reactionFieldsAreValid();
      allow delete: if signedIn()
        && request.auth.uid == userId
        && canAccessReactionMessage();
    }

    match /conversations/{conversationId}/messages/{messageId}/readReceipts/{userId} {
      function sourceMessage() {
        return get(
          /databases/$(database)/documents/messages/$(messageId)
        );
      }

      function canAccessReceiptMessage() {
        return exists(
            /databases/$(database)/documents/messages/$(messageId)
          )
          && sourceMessage().data.conversationId == conversationId
          && canAccessConversation(conversationFor(conversationId));
      }

      function receiptFieldsAreValid() {
        return request.resource.data.keys().hasOnly([
            "status", "deliveredAt", "readAt", "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "status", "deliveredAt", "readAt", "updatedAt"
          ])
          && request.resource.data.status in [
            "sent", "delivered", "read"
          ]
          && request.resource.data.updatedAt == request.time
          && (
            request.resource.data.status == "sent"
              ? request.resource.data.deliveredAt == null
                && request.resource.data.readAt == null
              : request.resource.data.status == "delivered"
                ? request.resource.data.deliveredAt == request.time
                  && request.resource.data.readAt == null
                : request.resource.data.deliveredAt is timestamp
                  && request.resource.data.readAt == request.time
          );
      }

      function receiptTransitionIsValid() {
        return (
            resource.data.status == "sent"
            && request.resource.data.status in ["delivered", "read"]
          )
          || (
            resource.data.status == "delivered"
            && request.resource.data.status == "read"
            && request.resource.data.deliveredAt
              == resource.data.deliveredAt
          );
      }

      allow read: if canAccessReceiptMessage();
      allow create: if signedIn()
        && request.auth.uid == userId
        && canAccessReceiptMessage()
        && receiptFieldsAreValid();
      allow update: if signedIn()
        && request.auth.uid == userId
        && canAccessReceiptMessage()
        && receiptFieldsAreValid()
        && receiptTransitionIsValid();
      allow delete: if false;
    }

    match /messages/{messageId} {
      function messageContentIsValid() {
        return request.resource.data.type in [
            "text", "image", "file", "voice", "system"
          ]
          && (
            (
              request.resource.data.type == "voice"
              && request.resource.data.voice is map
              && request.resource.data.voice.keys().hasOnly([
                  "url", "storagePath", "duration", "mimeType", "size"
                ])
              && request.resource.data.voice.keys().hasAll([
                  "url", "storagePath", "duration", "mimeType", "size"
                ])
              && request.resource.data.voice.url is string
              && request.resource.data.voice.url.matches('^https://.+$')
              && request.resource.data.voice.storagePath is string
              && request.resource.data.voice.storagePath.matches(
                '^voice/' + request.resource.data.conversationId +
                '/' + request.auth.uid + '/[^/]+[.](webm|ogg)$'
              )
              && request.resource.data.voice.duration is number
              && request.resource.data.voice.duration >= 0
              && request.resource.data.voice.duration <= 5 * 60 * 1000
              && request.resource.data.voice.mimeType is string
              && request.resource.data.voice.mimeType.matches(
                '^audio/(webm|ogg)(;.*)?$'
              )
              && request.resource.data.voice.size is int
              && request.resource.data.voice.size > 0
              && request.resource.data.voice.size <= 25 * 1024 * 1024
            )
            || (
              request.resource.data.type != "voice"
              && request.resource.data.voice == null
            )
          );
      }

      allow read: if canAccessConversation(
        conversationFor(resource.data.conversationId)
      );
      allow create: if signedIn()
        && messageContentIsValid()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.edited == false
        && request.resource.data.editedAt == null
        && request.resource.data.deleted == false
        && request.resource.data.deletedFor == []
        && request.resource.data.deletedAt == null
        && request.resource.data.deliveredAt == null
        && request.resource.data.readAt == null
        && canAccessConversation(
          conversationFor(request.resource.data.conversationId)
        )
        && (
          (
            conversationFor(request.resource.data.conversationId)
              .get("type", "direct") == "direct"
            && request.resource.data.receiverId != request.auth.uid
            && request.resource.data.receiverId in conversationFor(
              request.resource.data.conversationId
            ).participantIds
            && request.resource.data.get("groupId", null) == null
            && request.resource.data.readBy == []
          )
          ||
          (
            conversationFor(request.resource.data.conversationId)
              .get("type", "direct") == "group"
            && request.resource.data.receiverId == null
            && request.resource.data.groupId == conversationFor(
              request.resource.data.conversationId
            ).groupId
            && request.resource.data.readBy == [request.auth.uid]
          )
        );
      allow update: if signedIn()
        && (
          (
            request.auth.uid == resource.data.receiverId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["deliveredAt", "readAt"])
          )
          ||
          (
            canAccessConversation(conversationFor(resource.data.conversationId))
            && resource.data.get("groupId", null) != null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["readBy"])
            && request.resource.data.readBy is list
            && request.resource.data.readBy.toSet()
              == resource.data.get("readBy", []).toSet()
                .union([request.auth.uid].toSet())
            && request.resource.data.readBy.size()
              == request.resource.data.readBy.toSet().size()
          )
          ||
          (
            request.auth.uid == resource.data.senderId
            && resource.data.type == "text"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["text", "edited", "editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.edited == true
            && request.resource.data.editedAt == request.time
          )
          ||
          (
            request.auth.uid == resource.data.senderId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "text", "deleted", "deletedAt", "fileUrl",
                "fileName", "fileSize", "mimeType", "voice"
              ])
            && request.resource.data.text == "This message was deleted."
            && request.resource.data.deleted == true
            && request.resource.data.deletedAt == request.time
            && request.resource.data.fileUrl == null
            && request.resource.data.fileName == null
            && request.resource.data.fileSize == null
            && request.resource.data.mimeType == null
            && request.resource.data.voice == null
          )
          ||
          (
            canAccessConversation(conversationFor(resource.data.conversationId))
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["deletedFor"])
            && request.resource.data.deletedFor is list
            && request.resource.data.deletedFor.toSet()
              == resource.data.get("deletedFor", []).toSet()
                .union([request.auth.uid].toSet())
            && request.resource.data.deletedFor.size()
              == request.resource.data.deletedFor.toSet().size()
          )
        );
      allow delete: if false;
    }
    match /communities/{communityId} {
      allow read: if signedIn()
        && (
          resource.data.visibility == "public"
          || isCommunityMember(communityId)
        );
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(
          /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
        )
        && existsAfter(
          /databases/$(database)/documents/communities/$(communityId)/channels/general
        );
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          isCommunityManager(communityId)
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["memberCount", "updatedAt"])
            && (
              (
                !isCommunityMember(communityId)
                && existsAfter(
                  /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
                )
                && request.resource.data.memberCount
                  == resource.data.memberCount + 1
              )
              || (
                isCommunityMember(communityId)
                && !existsAfter(
                  /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
                )
                && request.resource.data.memberCount
                  == resource.data.memberCount - 1
              )
            )
          )
        );
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        allow read: if signedIn()
          && (
            userId == request.auth.uid
            || isCommunityMember(communityId)
          );
        allow create: if signedIn()
          && request.resource.data.userId == userId
          && request.resource.data.communityId == communityId
          && request.resource.data.role in [
            "owner", "admin", "moderator", "member"
          ]
          && (
            (
              userId == request.auth.uid
              && request.resource.data.role == "member"
            )
            || (
              getAfter(
                /databases/$(database)/documents/communities/$(communityId)
              ).data.ownerId == userId
              && request.resource.data.role == "owner"
            )
            || (
              isCommunityManagerAfter(communityId)
              && (
                getAfter(
                  /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
                ).data.role == "owner"
                || request.resource.data.role in ["moderator", "member"]
              )
            )
          );
        allow update: if signedIn()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.communityId == resource.data.communityId
          && request.resource.data.joinedAt == resource.data.joinedAt
          && (
            (
              userId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["nickname"])
            )
            || (
              isCommunityManager(communityId)
              && resource.data.role != "owner"
              && request.resource.data.role in [
                "admin", "moderator", "member"
              ]
              && (
                get(
                  /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
                ).data.role == "owner"
                || (
                  resource.data.role in ["moderator", "member"]
                  && request.resource.data.role in ["moderator", "member"]
                )
              )
            )
          );
        allow delete: if signedIn()
          && resource.data.role != "owner"
          && (
            userId == request.auth.uid
            || (
              isCommunityManager(communityId)
              && (
                get(
                  /databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)
                ).data.role == "owner"
                || resource.data.role in ["moderator", "member"]
              )
            )
          );
      }

      match /reputation/{userId} {
        allow read: if isCommunityMember(communityId);
        allow create, update, delete: if false;
      }

      match /reputationEvents/{eventId} {
        allow read: if isCommunityMember(communityId);
        allow create, update, delete: if false;
      }

      match /reputationSignals/{signalId} {
        allow read, create, update, delete: if false;
      }

      match /topicTags/{tagId} {
        allow read: if isCommunityMember(communityId);
        allow create: if isCommunityMember(communityId)
          && (
            isCommunityModerator(communityId)
            || hasCommunityTrust(communityId, 1)
          )
          && request.resource.data.keys().hasOnly([
            "label", "createdBy", "createdByName", "createdAt"
          ])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 30
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName is string
          && request.resource.data.createdByName.size() > 0
          && request.resource.data.createdByName.size() <= 120
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isCommunityModerator(communityId);
      }

      match /curationFlags/{flagId} {
        function flaggedQuestion() {
          return get(
            /databases/$(database)/documents/communities/$(communityId)/questions/$(request.resource.data.questionId)
          );
        }

        allow get: if isCommunityMember(communityId)
          && (
            isCommunityModerator(communityId)
            || hasCommunityTrust(communityId, 2)
          );
        allow list: if isCommunityMember(communityId)
          && (
            isCommunityModerator(communityId)
            || hasCommunityTrust(communityId, 3)
          );
        allow create: if isCommunityMember(communityId)
          && (
            isCommunityModerator(communityId)
            || hasCommunityTrust(communityId, 2)
          )
          && request.resource.data.keys().hasOnly([
            "type", "questionId", "questionTitle", "status",
            "createdBy", "createdByName", "createdAt"
          ])
          && request.resource.data.type == "possible_duplicate"
          && request.resource.data.status == "open"
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName is string
          && request.resource.data.createdByName.size() > 0
          && request.resource.data.createdByName.size() <= 120
          && request.resource.data.questionId is string
          && request.resource.data.questionId.size() > 0
          && flaggedQuestion().data.title
            == request.resource.data.questionTitle
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isCommunityModerator(communityId);
      }

      match /knowledgeCollections/{collectionId} {
        function collectionFieldsAreValid() {
          return request.resource.data.keys().hasOnly([
              "title", "description", "tags", "items", "itemCount",
              "contributors", "createdBy", "createdByName", "createdAt",
              "updatedBy", "updatedAt"
            ])
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.description is string
            && request.resource.data.description.size() > 0
            && request.resource.data.description.size() <= 2000
            && request.resource.data.tags is list
            && request.resource.data.tags.size() > 0
            && request.resource.data.tags.size() <= 5
            && request.resource.data.items is list
            && request.resource.data.items.size() > 0
            && request.resource.data.items.size() <= 20
            && request.resource.data.itemCount
              == request.resource.data.items.size()
            && request.resource.data.contributors is list
            && request.resource.data.contributors.size() > 0
            && request.resource.data.contributors.size() <= 30;
        }

        function suggestedItemIsValid(item) {
          return item is map
            && item.keys().hasOnly([
              "id", "sourceId", "sourceType", "title", "content", "url",
              "extension", "originalName", "addedBy", "addedByName"
            ])
            && item.id is string
            && item.id.size() > 0
            && item.id.size() <= 400
            && item.sourceId is string
            && item.sourceId.size() > 0
            && item.sourceId.size() <= 300
            && item.sourceType in [
              "resource", "question", "answer", "quiz", "flashcard_set"
            ]
            && item.title is string
            && item.title.size() > 0
            && item.title.size() <= 160
            && item.content is string
            && item.content.size() <= 5000
            && item.url is string
            && item.url.size() <= 2000
            && item.extension is string
            && item.extension.size() <= 20
            && item.originalName is string
            && item.originalName.size() <= 255
            && item.addedBy == request.auth.uid
            && item.addedByName is string
            && item.addedByName.size() > 0
            && item.addedByName.size() <= 120;
        }

        allow read: if isCommunityMember(communityId);
        allow create: if canCurateCommunityKnowledge(communityId)
          && collectionFieldsAreValid()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName is string
          && request.resource.data.createdByName.size() > 0
          && request.resource.data.createdByName.size() <= 120
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if canCurateCommunityKnowledge(communityId)
          && collectionFieldsAreValid()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if isCommunityModerator(communityId);

        match /saves/{userId} {
          allow read: if isCommunityMember(communityId)
            && userId == request.auth.uid;
          allow create: if isCommunityMember(communityId)
            && userId == request.auth.uid
            && request.resource.data.keys().hasOnly([
              "collectionId", "communityId", "userId", "savedAt"
            ])
            && request.resource.data.collectionId == collectionId
            && request.resource.data.communityId == communityId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.savedAt == request.time;
          allow update: if false;
          allow delete: if userId == request.auth.uid
            || isCommunityModerator(communityId);
        }

        match /suggestions/{suggestionId} {
          allow read: if isCommunityMember(communityId)
            && (
              resource.data.proposedBy == request.auth.uid
              || canCurateCommunityKnowledge(communityId)
            );
          allow create: if isCommunityMember(communityId)
            && request.resource.data.keys().hasOnly([
              "item", "note", "proposedBy", "proposedByName", "status",
              "createdAt", "reviewedAt", "reviewedBy"
            ])
            && suggestedItemIsValid(request.resource.data.item)
            && request.resource.data.proposedBy == request.auth.uid
            && request.resource.data.proposedByName is string
            && request.resource.data.proposedByName.size() > 0
            && request.resource.data.proposedByName.size() <= 120
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 500
            && request.resource.data.status == "pending"
            && request.resource.data.createdAt == request.time
            && request.resource.data.reviewedAt == null
            && request.resource.data.reviewedBy == null;
          allow update: if canCurateCommunityKnowledge(communityId)
            && resource.data.status == "pending"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "reviewedAt", "reviewedBy"])
            && request.resource.data.status in ["approved", "rejected"]
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedBy == request.auth.uid;
          allow delete: if isCommunityModerator(communityId);
        }
      }

      match /questions/{questionId} {
        function questionContentIsValid() {
          return request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 160
            && request.resource.data.description is string
            && request.resource.data.description.size() > 0
            && request.resource.data.description.size() <= 5000
            && request.resource.data.tags is list
            && request.resource.data.tags.size() > 0
            && request.resource.data.tags.size() <= 5
            && (
              request.resource.data.linkedResource == null
              || (
                request.resource.data.linkedResource is map
                && request.resource.data.linkedResource.keys()
                  .hasOnly(["id", "title"])
                && request.resource.data.linkedResource.id is string
                && request.resource.data.linkedResource.id.size() > 0
                && request.resource.data.linkedResource.title is string
                && request.resource.data.linkedResource.title.size() > 0
                && request.resource.data.linkedResource.title.size() <= 160
              )
            );
        }

        function questionAuthor() {
          return signedIn() && resource.data.authorId == request.auth.uid;
        }

        allow read: if isCommunityMember(communityId);
        allow create: if isCommunityMember(communityId)
          && request.resource.data.keys().hasOnly([
            "title", "description", "tags", "linkedResource",
            "authorId", "authorName", "acceptedAnswerId", "answerCount",
            "upvoteCount", "status", "createdAt", "updatedAt"
          ])
          && questionContentIsValid()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.acceptedAnswerId == null
          && request.resource.data.answerCount == 0
          && request.resource.data.upvoteCount == 0
          && request.resource.data.status == "unanswered"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isCommunityMember(communityId)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (
            (
              questionAuthor()
              && questionContentIsValid()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  "title", "description", "tags", "linkedResource",
                  "updatedAt"
                ])
            )
            || (
              (questionAuthor() || isCommunityModerator(communityId))
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  "acceptedAnswerId", "answerCount", "status", "updatedAt"
                ])
              && request.resource.data.answerCount >= 0
              && request.resource.data.status in [
                "unanswered", "answered", "solved"
              ]
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["upvoteCount", "updatedAt"])
              && request.resource.data.upvoteCount >= 0
              && (
                (
                  request.resource.data.upvoteCount
                    == resource.data.upvoteCount + 1
                  && !exists(
                    /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/upvotes/$(request.auth.uid)
                  )
                  && existsAfter(
                    /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/upvotes/$(request.auth.uid)
                  )
                )
                || (
                  request.resource.data.upvoteCount
                    == resource.data.upvoteCount - 1
                  && exists(
                    /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/upvotes/$(request.auth.uid)
                  )
                  && !existsAfter(
                    /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/upvotes/$(request.auth.uid)
                  )
                )
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["answerCount", "status", "updatedAt"])
              && request.resource.data.answerCount
                == resource.data.answerCount + 1
              && request.resource.data.status in ["answered", "solved"]
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  "acceptedAnswerId", "answerCount", "status", "updatedAt"
                ])
              && request.resource.data.answerCount
                == resource.data.answerCount - 1
              && request.resource.data.answerCount >= 0
              && request.resource.data.status in [
                "unanswered", "answered", "solved"
              ]
            )
          );
        allow delete: if questionAuthor()
          || isCommunityModerator(communityId);

        match /upvotes/{userId} {
          function parentQuestion() {
            return get(
              /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)
            );
          }

          allow read: if isCommunityMember(communityId);
          allow create: if isCommunityMember(communityId)
            && userId == request.auth.uid
            && request.resource.data.keys().hasOnly([
              "userId", "recipientId", "recipientName", "createdAt"
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.recipientId
              == parentQuestion().data.authorId
            && request.resource.data.recipientId != request.auth.uid
            && request.resource.data.recipientName
              == parentQuestion().data.authorName
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if isCommunityMember(communityId)
            && (
              userId == request.auth.uid
              || parentQuestion().data.authorId == request.auth.uid
              || isCommunityModerator(communityId)
            );
        }

        match /answers/{answerId} {
          function questionDocument() {
            return get(
              /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)
            );
          }

          function answerAuthor() {
            return signedIn() && resource.data.authorId == request.auth.uid;
          }

          function answerDocument() {
            return get(
              /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/answers/$(answerId)
            );
          }

          function answerOwnerId() {
            return answerDocument().data.authorId;
          }

          function answerOwnerName() {
            return answerDocument().data.authorName;
          }

          function questionOwner() {
            return signedIn()
              && questionDocument().data.authorId == request.auth.uid;
          }

          function answerOwner() {
            return signedIn()
              && answerOwnerId() == request.auth.uid;
          }

          allow read: if isCommunityMember(communityId);
          allow create: if isCommunityMember(communityId)
            && request.resource.data.keys().hasOnly([
              "authorId", "authorName", "content", "accepted",
              "questionAuthorId", "upvoteCount", "createdAt", "updatedAt"
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 120
            && request.resource.data.questionAuthorId
              == questionDocument().data.authorId
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 5000
            && request.resource.data.accepted == false
            && request.resource.data.upvoteCount == 0
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if isCommunityMember(communityId)
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.questionAuthorId
              == resource.data.questionAuthorId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && (
              (
                answerAuthor()
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["content", "updatedAt"])
                && request.resource.data.content is string
                && request.resource.data.content.size() > 0
                && request.resource.data.content.size() <= 5000
              )
              || (
                questionOwner()
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["accepted", "updatedAt"])
                && request.resource.data.accepted is bool
              )
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["upvoteCount", "updatedAt"])
                && request.resource.data.upvoteCount >= 0
                && (
                  (
                    request.resource.data.upvoteCount
                      == resource.data.upvoteCount + 1
                    && !exists(
                      /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/answers/$(answerId)/upvotes/$(request.auth.uid)
                    )
                    && existsAfter(
                      /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/answers/$(answerId)/upvotes/$(request.auth.uid)
                    )
                  )
                  || (
                    request.resource.data.upvoteCount
                      == resource.data.upvoteCount - 1
                    && exists(
                      /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/answers/$(answerId)/upvotes/$(request.auth.uid)
                    )
                    && !existsAfter(
                      /databases/$(database)/documents/communities/$(communityId)/questions/$(questionId)/answers/$(answerId)/upvotes/$(request.auth.uid)
                    )
                  )
                )
              )
            );
          allow delete: if answerAuthor()
            || questionOwner()
            || isCommunityModerator(communityId);

          match /upvotes/{userId} {
            allow read: if isCommunityMember(communityId);
            allow create: if isCommunityMember(communityId)
              && userId == request.auth.uid
              && request.resource.data.keys().hasOnly([
                "userId", "recipientId", "recipientName", "createdAt"
              ])
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.recipientId == answerOwnerId()
              && request.resource.data.recipientId != request.auth.uid
              && request.resource.data.recipientName == answerOwnerName()
              && request.resource.data.createdAt == request.time;
            allow update: if false;
            allow delete: if isCommunityMember(communityId)
              && (
                userId == request.auth.uid
                || answerOwner()
                || questionOwner()
                || isCommunityModerator(communityId)
              );
          }

          match /comments/{commentId} {
            function commentAuthor() {
              return signedIn() && resource.data.authorId == request.auth.uid;
            }

            allow read: if isCommunityMember(communityId);
            allow create: if isCommunityMember(communityId)
              && request.resource.data.keys().hasOnly([
                "authorId", "authorName", "content", "createdAt", "updatedAt"
              ])
              && request.resource.data.authorId == request.auth.uid
              && request.resource.data.authorName is string
              && request.resource.data.authorName.size() > 0
              && request.resource.data.authorName.size() <= 120
              && request.resource.data.content is string
              && request.resource.data.content.size() > 0
              && request.resource.data.content.size() <= 1000
              && request.resource.data.createdAt == request.time
              && request.resource.data.updatedAt == request.time;
            allow update: if commentAuthor()
              && request.resource.data.authorId == resource.data.authorId
              && request.resource.data.authorName == resource.data.authorName
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["content", "updatedAt"])
              && request.resource.data.content is string
              && request.resource.data.content.size() > 0
              && request.resource.data.content.size() <= 1000
              && request.resource.data.updatedAt == request.time;
            allow delete: if commentAuthor()
              || answerOwner()
              || questionOwner()
              || isCommunityModerator(communityId);
          }
        }
      }

      match /channels/{channelId} {
        allow read: if isCommunityMember(communityId);
        allow create: if isCommunityManagerAfter(communityId)
          && request.resource.data.communityId == communityId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 120
          && request.resource.data.type in ["TEXT", "ANNOUNCEMENTS"]
          && request.resource.data.position is number
          && request.resource.data.position >= 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isCommunityManager(communityId)
          && request.resource.data.communityId == resource.data.communityId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            channelId != "general"
            || request.resource.data.name == "general"
          );
        allow delete: if isCommunityManager(communityId)
          && (
            channelId != "general"
            || get(
              /databases/$(database)/documents/communities/$(communityId)
            ).data.ownerId == request.auth.uid
          );

        match /messages/{messageId} {
          allow read: if isCommunityMember(communityId);
          allow create: if isCommunityMember(communityId)
            && request.resource.data.keys().hasOnly([
              "channelId",
              "senderId",
              "senderName",
              "senderPhotoURL",
              "text",
              "attachments",
              "replyTo",
              "type",
              "reactions",
              "edited",
              "deleted",
              "deletedAt",
              "pinnedAt",
              "pinnedBy",
              "readBy",
              "createdAt",
              "updatedAt"
            ])
            && request.resource.data.channelId == channelId
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderName is string
            && request.resource.data.senderName.size() > 0
            && request.resource.data.senderName.size() <= 120
            && (
              request.resource.data.senderPhotoURL == null
              || request.resource.data.senderPhotoURL is string
            )
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 5
            && (
              request.resource.data.replyTo == null
              || request.resource.data.replyTo is map
            )
            && request.resource.data.type == "TEXT"
            && request.resource.data.reactions is map
            && request.resource.data.edited == false
            && request.resource.data.deleted == false
            && request.resource.data.deletedAt == null
            && request.resource.data.pinnedAt == null
            && request.resource.data.pinnedBy == null
            && request.resource.data.readBy == [request.auth.uid]
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && (
              get(
                /databases/$(database)/documents/communities/$(communityId)/channels/$(channelId)
              ).data.type == "TEXT"
              || isCommunityManager(communityId)
            );
          allow update: if isCommunityMember(communityId)
            && request.resource.data.channelId == resource.data.channelId
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.senderName == resource.data.senderName
            && request.resource.data.senderPhotoURL
              == resource.data.senderPhotoURL
            && request.resource.data.replyTo == resource.data.replyTo
            && request.resource.data.type == resource.data.type
            && request.resource.data.readBy == resource.data.readBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && (
              (
                resource.data.senderId == request.auth.uid
                && resource.data.deleted == false
                && request.resource.data.deleted == false
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    "text",
                    "edited",
                    "updatedAt"
                  ])
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 2000
                && request.resource.data.edited == true
              )
              || (
                (
                  resource.data.senderId == request.auth.uid
                  || isCommunityModerator(communityId)
                )
                && resource.data.deleted == false
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    "text",
                    "attachments",
                    "deleted",
                    "deletedAt",
                    "updatedAt"
                  ])
                && request.resource.data.text == ""
                && request.resource.data.attachments == []
                && request.resource.data.deleted == true
                && request.resource.data.deletedAt == request.time
              )
              || (
                resource.data.deleted == false
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["reactions", "updatedAt"])
                && request.resource.data.reactions is map
              )
              || (
                isCommunityModerator(communityId)
                && resource.data.deleted == false
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(["pinnedAt", "pinnedBy", "updatedAt"])
                && (
                  (
                    request.resource.data.pinnedAt == request.time
                    && request.resource.data.pinnedBy == request.auth.uid
                  )
                  || (
                    request.resource.data.pinnedAt == null
                    && request.resource.data.pinnedBy == null
                  )
                )
              )
            );
          allow delete: if isCommunityManager(communityId);
        }

        match /files/{fileId} {
          allow read: if isCommunityMember(communityId);
          allow create: if isCommunityMember(communityId)
            && request.resource.data.keys().hasOnly([
              "name",
              "filename",
              "normalizedFilename",
              "originalName",
              "extension",
              "size",
              "type",
              "url",
              "storagePath",
              "uploadedBy",
              "uploadedByName",
              "uploadedAt",
              "communityId",
              "channelId",
              "messageId",
              "tags"
            ])
            && request.resource.data.communityId == communityId
            && request.resource.data.channelId == channelId
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.originalName is string
            && request.resource.data.originalName.size() > 0
            && request.resource.data.originalName.size() <= 255
            && request.resource.data.filename is string
            && request.resource.data.filename == request.resource.data.originalName
            && request.resource.data.normalizedFilename is string
            && request.resource.data.normalizedFilename.size() > 0
            && request.resource.data.normalizedFilename.size() <= 255
            && request.resource.data.tags is list
            && request.resource.data.tags.size() <= 10
            && request.resource.data.extension in [
              "png", "jpg", "jpeg", "gif", "webp", "pdf", "doc", "docx",
              "ppt", "pptx", "xls", "xlsx", "zip", "txt", "csv"
            ]
            && request.resource.data.size is int
            && request.resource.data.size > 0
            && request.resource.data.size <= 25 * 1024 * 1024
            && request.resource.data.type is string
            && request.resource.data.url is string
            && request.resource.data.url.size() > 0
            && request.resource.data.storagePath is string
            && request.resource.data.storagePath.matches(
              '^communities/' + communityId
              + '/channels/' + channelId
              + '/files/' + fileId + '/[^/]+$'
            )
            && request.resource.data.uploadedAt == request.time
            && (
              request.resource.data.messageId == null
              || request.resource.data.messageId is string
            );
          allow update: if false;
          allow delete: if isCommunityManager(communityId)
            || (
              isCommunityMember(communityId)
              && resource.data.uploadedBy == request.auth.uid
            );
        }

        match /typing/{userId} {
          allow read: if isCommunityMember(communityId);
          allow create, update: if isCommunityMember(communityId)
            && userId == request.auth.uid
            && request.resource.data.keys().hasOnly([
              "userId", "displayName", "updatedAt"
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 120
            && request.resource.data.updatedAt == request.time;
          allow delete: if userId == request.auth.uid
            || isCommunityManager(communityId);
        }
      }

      match /activities/{activityId} {
        allow read: if isCommunityMember(communityId);
        allow create: if isCommunityMember(communityId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.communityId == communityId
          && request.resource.data.type in [
            "announcement_posted",
            "channel_created",
            "file_uploaded",
            "member_joined"
          ]
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isCommunityManager(communityId);
      }
    }

    match /groups/{groupId} {
      function groupFieldsAreValid() {
        return request.resource.data.keys().hasOnly([
            "name",
            "description",
            "moduleCode",
            "moduleName",
            "tags",
            "ownerId",
            "visibility",
            "photoURL",
            "memberCount",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 3
          && request.resource.data.name.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.moduleCode is string
          && request.resource.data.moduleCode.size() <= 30
          && request.resource.data.moduleName is string
          && request.resource.data.moduleName.size() > 0
          && request.resource.data.moduleName.size() <= 120
          && (
            !("tags" in request.resource.data)
            || (
              request.resource.data.tags is list
              && request.resource.data.tags.size() <= 5
            )
          )
          && request.resource.data.photoURL is string
          && request.resource.data.visibility in ["public", "private"]
          && request.resource.data.memberCount is int
          && request.resource.data.memberCount >= 1;
      }

      allow read: if signedIn()
        && (
          resource.data.visibility == "public"
          || isGroupMember(groupId)
        );
      allow create: if signedIn()
        && groupFieldsAreValid()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && groupFieldsAreValid()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            isGroupManager(groupId)
            && request.resource.data.memberCount == resource.data.memberCount
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "name",
                "description",
                "moduleCode",
                "moduleName",
                "tags",
                "visibility",
                "photoURL",
                "updatedAt"
              ])
            && request.resource.data.updatedAt == request.time
          )
          || (
            resource.data.visibility == "public"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["memberCount", "updatedAt"])
            && request.resource.data.memberCount
              == resource.data.memberCount + 1
            && request.resource.data.updatedAt == request.time
            && !exists(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
            && existsAfter(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
          )
          || (
            resource.data.ownerId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["memberCount", "updatedAt"])
            && request.resource.data.memberCount
              == resource.data.memberCount - 1
            && request.resource.data.updatedAt == request.time
            && exists(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
            && !existsAfter(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            )
          )
        );
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        function groupAfterWrite() {
          return getAfter(
            /databases/$(database)/documents/groups/$(groupId)
          );
        }

        function memberFieldsAreValid() {
          return request.resource.data.keys().hasOnly([
              "userId",
              "displayName",
              "photoURL",
              "role",
              "joinedAt"
            ])
            && request.resource.data.userId == userId
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 120
            && request.resource.data.photoURL is string
            && request.resource.data.role in [
              "owner",
              "admin",
              "moderator",
              "member"
            ];
        }

        allow read: if signedIn()
          && (
            resource.data.userId == request.auth.uid
            || get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.visibility == "public"
            || isGroupMember(groupId)
          );
        allow create: if signedIn()
          && request.auth.uid == userId
          && memberFieldsAreValid()
          && request.resource.data.joinedAt == request.time
          && (
            (
              groupAfterWrite().data.ownerId == request.auth.uid
              && request.resource.data.role == "owner"
            )
            ||
            (
              groupAfterWrite().data.ownerId != request.auth.uid
              && groupAfterWrite().data.visibility == "public"
              && groupAfterWrite().data.memberCount
                == get(
                  /databases/$(database)/documents/groups/$(groupId)
                ).data.memberCount + 1
              && request.resource.data.role == "member"
            )
          );
        allow update: if signedIn()
          && memberFieldsAreValid()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.joinedAt == resource.data.joinedAt
          && (
            get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.ownerId == request.auth.uid
            ||
            (
              request.auth.uid == userId
              && request.resource.data.role == resource.data.role
            )
          );
        allow delete: if signedIn()
          && resource.data.role != "owner"
          && groupAfterWrite().data.memberCount
            == get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.memberCount - 1
          && (
            request.auth.uid == userId
            || get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.ownerId == request.auth.uid
          );
      }

      match /resources/{resourceId} {
        function isGroupResourceMember() {
          return signedIn()
            && exists(
              /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
            );
        }

        function isResourceUploader() {
          return signedIn()
            && resource.data.uploaderId == request.auth.uid;
        }

        function isGroupResourceOwner() {
          return signedIn()
            && get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.ownerId == request.auth.uid;
        }

        allow read: if isGroupResourceMember();

        allow create: if isGroupResourceMember()
          && request.resource.data.keys().hasOnly([
            "title",
            "description",
            "category",
            "fileURL",
            "storagePath",
            "fileName",
            "fileSize",
            "mimeType",
            "uploaderId",
            "uploaderName",
            "uploaderPhotoURL",
            "downloadCount",
            "verificationCount",
            "verifiedBy",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.uploaderId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.category in [
            "notes",
            "assignments",
            "past-papers",
            "memorandums",
            "practicals",
            "projects",
            "books",
            "other"
          ]
          && request.resource.data.fileURL is string
          && request.resource.data.storagePath is string
          && request.resource.data.fileName is string
          && request.resource.data.fileSize is int
          && request.resource.data.fileSize > 0
          && request.resource.data.fileSize <= 25 * 1024 * 1024
          && request.resource.data.mimeType is string
          && request.resource.data.downloadCount == 0
          && request.resource.data.verificationCount == 0
          && request.resource.data.verifiedBy == []
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if (
            isResourceUploader()
            || isGroupResourceOwner()
          )
          && request.resource.data.uploaderId == resource.data.uploaderId
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["title", "description", "category", "updatedAt"])
          && request.resource.data.updatedAt == request.time
          || (
            isGroupResourceMember()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["downloadCount", "updatedAt"])
            && request.resource.data.downloadCount
              == resource.data.downloadCount + 1
            && request.resource.data.updatedAt == request.time
          );

        allow delete: if isResourceUploader()
          || isGroupResourceOwner();
      }

      match /assignments/{assignmentId} {
        function isAssignmentCreator() {
          return signedIn()
            && resource.data.createdBy == request.auth.uid;
        }

        function isAssignmentGroupOwner() {
          return signedIn()
            && get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.ownerId == request.auth.uid;
        }

        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if isAssignmentCreator()
          || isAssignmentGroupOwner();
      }

      match /activities/{activityId} {
        function activityFieldsAreValid() {
          return request.resource.data.keys().hasOnly([
              "type",
              "actorId",
              "actorName",
              "title",
              "description",
              "groupId",
              "referenceId",
              "visibility",
              "metadata",
              "createdAt",
              "updatedAt"
            ])
            && request.resource.data.keys().hasAll([
              "type",
              "actorId",
              "actorName",
              "title",
              "description",
              "groupId",
              "referenceId",
              "visibility",
              "metadata",
              "createdAt",
              "updatedAt"
            ])
            && request.resource.data.type in [
              "assignment_created",
              "assignment_updated",
              "resource_created",
              "message_sent",
              "friend_request_accepted",
              "group_created",
              "group_joined",
              "system"
            ]
            && request.resource.data.actorId is string
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.actorName is string
            && request.resource.data.actorName.size() <= 120
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 160
            && request.resource.data.description is string
            && request.resource.data.groupId == groupId
            && request.resource.data.referenceId is string
            && request.resource.data.visibility in [
              "group", "friends", "private", "public"
            ]
            && request.resource.data.metadata is map
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
        }

        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && activityFieldsAreValid();
        allow update: if false;
        allow delete: if signedIn()
          && (
            resource.data.actorId == request.auth.uid
            || isGroupManager(groupId)
            || isAdmin()
          );
      }
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      // The parent path already scopes these documents to their owner. Keeping
      // reads path-based also lets users load legacy notifications created
      // before recipientId became a required field.
      allow read: if isOwner(userId);
      allow create: if signedIn()
        && notificationFieldsAreValid(userId)
        && notificationSourceIsValid(userId);
      allow update: if isOwner(userId)
        && resource.data.recipientId == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["read", "updatedAt"])
        && request.resource.data.read is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/conversationPreferences/{conversationId} {
      function preferenceFieldsAreValid() {
        return request.resource.data.keys().hasOnly([
            "conversationId", "userId", "pinned", "muted", "archived",
            "createdAt", "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "conversationId", "userId", "pinned", "muted", "archived",
            "createdAt", "updatedAt"
          ])
          && request.resource.data.conversationId == conversationId
          && request.resource.data.userId == userId
          && request.resource.data.pinned is bool
          && request.resource.data.muted is bool
          && request.resource.data.archived is bool
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && preferenceFieldsAreValid()
        && request.resource.data.createdAt == request.time
        && canAccessConversation(conversationFor(conversationId));
      allow update: if isOwner(userId)
        && preferenceFieldsAreValid()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["pinned", "muted", "archived", "updatedAt"])
        && canAccessConversation(conversationFor(conversationId));
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/presence/{presenceId} {
      function presenceFieldsAreValid() {
        return presenceId == "status"
          && request.resource.data.keys().hasOnly([
            "status",
            "conversationId",
            "lastSeen",
            "updatedAt",
            "userName"
          ])
          && request.resource.data.keys().hasAll([
            "status",
            "conversationId",
            "lastSeen",
            "updatedAt"
          ])
          && request.resource.data.status in [
            "online", "offline", "typing"
          ]
          && request.resource.data.conversationId is string
          && (
            request.resource.data.status == "typing"
              ? request.resource.data.conversationId.size() > 0
              : request.resource.data.conversationId == ""
          )
          && (
            !("userName" in request.resource.data)
            || (
              request.resource.data.userName is string
              && request.resource.data.userName.size() <= 120
            )
          )
          && (
            request.resource.data.lastSeen == null
            || request.resource.data.lastSeen is timestamp
          )
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if signedIn();
      allow create: if isOwner(userId)
        && presenceFieldsAreValid()
        && (
          request.resource.data.status == "offline"
            ? request.resource.data.lastSeen == request.time
            : request.resource.data.lastSeen == null
        );
      allow update: if isOwner(userId)
        && presenceFieldsAreValid()
        && (
          request.resource.data.status == "offline"
            ? request.resource.data.lastSeen == request.time
            : request.resource.data.lastSeen == resource.data.lastSeen
        );
      allow delete: if false;
    }

    // Legacy presence documents remain read-only so collection-group typing
    // queries cannot be blocked by the retired root-level collection.
    match /presence/{legacyPresenceId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /achievements/{achievementId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /platform/{documentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

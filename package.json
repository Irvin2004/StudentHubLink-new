{
    "name": "studenthub-web",
    "version": "1.0.0",
    "description": "Student collaboration, messaging, and academic resource platform.",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "preview": "vite preview --host 127.0.0.1",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "npm run test:unit && npm run test:architecture",
        "test:unit": "vitest run",
        "test:watch": "vitest",
        "test:architecture": "node --test \"test/*.test.js\"",
        "check:syntax": "node scripts/check-js.mjs",
        "check": "npm run lint && npm run format:check && npm run check:syntax && npm test && npm run build",
        "prepare": "husky"
    },
    "dependencies": {
        "firebase": "^12.16.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "*.{js,jsx,mjs}": [
            "eslint --fix --max-warnings=0",
            "prettier --write"
        ],
        "*.{css,html,json,md,yml,yaml}": "prettier --write"
    }
}

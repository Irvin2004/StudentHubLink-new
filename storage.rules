rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(image/(gif|jpeg|png|webp)|text/(plain|csv)|application/(csv|pdf|msword|vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|vnd[.]ms-powerpoint|vnd[.]openxmlformats-officedocument[.]presentationml[.]presentation|vnd[.]ms-excel|vnd[.]openxmlformats-officedocument[.]spreadsheetml[.]sheet|zip|x-zip-compressed|octet-stream))$'
        )
        && request.resource.name.matches(
          '.*[.](jpg|jpeg|gif|png|webp|pdf|doc|docx|ppt|pptx|xls|xlsx|zip|txt|csv)$'
        );
    }

    function isAllowedVoiceUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches(
          '^audio/(webm|ogg)(;.*)?$'
        )
        && request.resource.name.matches('.*[.](webm|ogg)$');
    }

    function conversation(conversationId) {
      return firestore.get(
        /databases/(default)/documents/conversations/$(conversationId)
      ).data;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)
        );
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/groups/$(groupId)
        ).data.ownerId == request.auth.uid;
    }

    function isCommunityMember(communityId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid)
        );
    }

    function isCommunityManager(communityId) {
      return isCommunityMember(communityId)
        && firestore.get(
          /databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid)
        ).data.role in ["owner", "admin"];
    }

    function canAccessConversation(conversationId) {
      return signedIn()
        && (
          (
            conversation(conversationId).type == "direct"
            && request.auth.uid in conversation(conversationId).participantIds
          )
          ||
          (
            conversation(conversationId).type == "group"
            && isGroupMember(conversation(conversationId).groupId)
          )
        );
    }

    match /messages/{conversationId}/{senderId}/{fileName} {
      allow read: if canAccessConversation(conversationId);
      allow create, update: if canAccessConversation(conversationId)
        && request.auth.uid == senderId
        && isAllowedUpload();
      allow delete: if canAccessConversation(conversationId)
        && request.auth.uid == senderId;
    }

    match /messages/{conversationId}/{legacyFileName} {
      allow read: if canAccessConversation(conversationId);
      allow write: if false;
    }

    match /voice/{conversationId}/{userId}/{fileName} {
      allow read: if canAccessConversation(conversationId);
      allow create, update: if canAccessConversation(conversationId)
        && request.auth.uid == userId
        && isAllowedVoiceUpload();
      allow delete: if canAccessConversation(conversationId)
        && request.auth.uid == userId;
    }

    match /groups/{groupId}/resources/{uploaderId}/{fileName} {
      allow read: if isGroupMember(groupId);
      allow create, update: if isGroupMember(groupId)
        && request.auth.uid == uploaderId
        && isAllowedUpload();
      allow delete: if signedIn()
        && (
          request.auth.uid == uploaderId
          || isGroupOwner(groupId)
        );
    }

    match /groups/{groupId}/resources/{legacyFileName} {
      allow read: if isGroupMember(groupId);
      allow write: if false;
    }

    match /communities/{communityId}/channels/{channelId}/files/{fileId}/{fileName} {
      allow read: if isCommunityMember(communityId);
      allow create: if isCommunityMember(communityId)
        && isAllowedUpload()
        && request.resource.metadata.communityId == communityId
        && request.resource.metadata.channelId == channelId
        && request.resource.metadata.fileId == fileId
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if isCommunityMember(communityId)
        && (
          resource.metadata.uploadedBy == request.auth.uid
          || isCommunityManager(communityId)
        );
    }

    // Files uploaded before file IDs were added to the object path remain
    // available, but all new uploads must use the linked path above.
    match /communities/{communityId}/channels/{channelId}/files/{legacyFileName} {
      allow read: if isCommunityMember(communityId);
      allow create, update: if false;
      allow delete: if isCommunityMember(communityId)
        && (
          resource.metadata.uploadedBy == request.auth.uid
          || isCommunityManager(communityId)
        );
    }

    match /resources/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isAllowedUpload();
      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$')
        && request.resource.name.matches('.*[.](jpg|jpeg|png|webp)$');
      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

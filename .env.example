# Firebase web application configuration
# These values identify the Firebase project but must still be restricted by
# Firebase Authentication, Firestore rules, Storage rules, and API-key policy.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
